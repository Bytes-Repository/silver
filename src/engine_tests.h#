;; ---------- dom::parse ----------

#[test]
fn test_dom_parses_nested_tags() is
    let d: dom::Dom = dom::parse("<div><p>Hej</p></div>")
    ;; nodes[0] = root, nodes[1] = div, nodes[2] = p, nodes[3] = text "Hej"
    assert_eq(d.nodes[1].tag, "div")
    assert_eq(d.nodes[2].tag, "p")
    assert_eq(d.nodes[3].tag, "text")
    assert_eq(d.nodes[3].text, "Hej")
end

#[test]
fn test_dom_parses_attributes() is
    let d: dom::Dom = dom::parse("<div id=\"card\" class=\"a b\" on-click=\"go\"></div>")
    assert_eq(d.nodes[1].attr_id, "card")
    assert_eq(d.nodes[1].attr_class, "a b")
    assert_eq(d.nodes[1].on_click, "go")
end

#[test]
fn test_dom_self_closing_img() is
    let d: dom::Dom = dom::parse("<div><img src=\"logo.png\" /></div>")
    assert_eq(d.nodes[2].tag, "img")
    assert_eq(d.nodes[2].attr_src, "logo.png")
end

#[test]
fn test_dom_sibling_children_order() is
    let d: dom::Dom = dom::parse("<div><span>a</span><span>b</span></div>")
    let div_children: [int] = d.nodes[1].children
    assert_eq(array_len(div_children), 2)
end

;; ---------- css::parse + kaskada ----------

#[test]
fn test_css_parses_rule() is
    let sheet: css::Stylesheet = css::parse(".button { background: blue; padding: 12px; }")
    assert_eq(array_len(sheet.rules), 1)
    assert_eq(sheet.rules[0].selector, ".button")
    assert_eq(array_len(sheet.rules[0].decls), 2)
end

#[test]
fn test_css_specificity_id_beats_class() is
    let sheet: css::Stylesheet = css::parse(
        ".x { color: red; } #y { color: blue; }")
    let decls: [css::CssDecl] = css::matching_decls(sheet, "div", "y", ["x"])
    ;; kaskada: ostatnia (najbardziej specyficzna) deklaracja wygrywa
    assert_eq(decls[array_len(decls) - 1].val, "blue")
end

;; ---------- css.h# — naprawa: wiele klas na jednym tokenie (.a.b) ----------

#[test]
fn test_css_multi_class_selector_matches_element_with_both() is
    ;; ".btn.primary" wymaga OBU klas na TYM SAMYM elemencie — dawniej
    ;; ten selektor po cichu nigdy nie dopasowywał (patrz komentarz
    ;; przy `css::selector_matches`).
    let ok: bool = css::selector_matches(".btn.primary", "div", "", ["btn", "primary"])
    assert_true(ok)
end

#[test]
fn test_css_multi_class_selector_rejects_partial_match() is
    ;; element ma tylko "btn", nie "primary" -> nie powinno dopasować
    let ok: bool = css::selector_matches(".btn.primary", "div", "", ["btn"])
    assert_true(!ok)
end

#[test]
fn test_css_tag_plus_class_selector() is
    ;; "div.btn" — tag I klasa naraz
    assert_true(css::selector_matches("div.btn", "div", "", ["btn"]))
    assert_true(!css::selector_matches("div.btn", "span", "", ["btn"]))
end

#[test]
fn test_css_id_plus_class_selector() is
    assert_true(css::selector_matches("#card.active", "div", "card", ["active"]))
    assert_true(!css::selector_matches("#card.active", "div", "other", ["active"]))
end

;; ---------- css::parse — rozbudowa: komentarze /* ... */ ----------

#[test]
fn test_css_strips_comment_before_selector() is
    ;; bez usuwania komentarzy ten komentarz wciągnąłby się do
    ;; selektora ".hint" i reguła po cichu przestałaby cokolwiek trafiać
    let sheet: css::Stylesheet = css::parse(
        "/* uwaga: to jest hint */\n.hint { color: red; }")
    assert_eq(array_len(sheet.rules), 1)
    assert_eq(sheet.rules[0].selector, ".hint")
end

#[test]
fn test_css_strips_comment_inside_block() is
    let sheet: css::Stylesheet = css::parse(
        ".x { /* to nie powinno się liczyć */ color: blue; }")
    assert_eq(array_len(sheet.rules[0].decls), 1)
    assert_eq(sheet.rules[0].decls[0].prop, "color")
end

#[test]
fn test_css_strips_multiple_comments() is
    let sheet: css::Stylesheet = css::parse(
        "/* a */ .x { color: red; } /* b */ .y { color: blue; }")
    assert_eq(array_len(sheet.rules), 2)
    assert_eq(sheet.rules[1].selector, ".y")
end

;; ---------- style::resolve — dziedziczenie ----------

#[test]
fn test_style_inherits_color() is
    let sheet: css::Stylesheet = css::parse("p { color: #ff0000; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "p", "", [], style::root_style())
    ;; dziecko bez własnej reguły powinno odziedziczyć kolor rodzica
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.color.r, 255)
    assert_eq(child.color.g, 0)
end

#[test]
fn test_style_heading_default_size() is
    let st: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "h1", "", [], style::root_style())
    assert_eq(st.font_size, 32)
end

;; ---------- style::resolve — rozbudowa: padding/margin per-strona ----------

#[test]
fn test_padding_shorthand_one_value() is
    let sheet: css::Stylesheet = css::parse("div { padding: 10px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_right, 10)
    assert_eq(st.pad_bottom, 10)
    assert_eq(st.pad_left, 10)
end

#[test]
fn test_padding_shorthand_two_values() is
    ;; góra/dół = 10, lewo/prawo = 20 — dokładnie jak w CSS
    let sheet: css::Stylesheet = css::parse("div { padding: 10px 20px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_bottom, 10)
    assert_eq(st.pad_right, 20)
    assert_eq(st.pad_left, 20)
end

#[test]
fn test_padding_shorthand_four_values() is
    ;; góra, prawo, dół, lewo — zgodnie z ruchem wskazówek zegara
    let sheet: css::Stylesheet = css::parse("div { padding: 1px 2px 3px 4px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 1)
    assert_eq(st.pad_right, 2)
    assert_eq(st.pad_bottom, 3)
    assert_eq(st.pad_left, 4)
end

#[test]
fn test_padding_longhand_overrides_shorthand() is
    ;; kolejność deklaracji w bloku decyduje — dokładnie jak w CSS,
    ;; więc padding-left po padding nadpisuje tylko lewy bok.
    let sheet: css::Stylesheet = css::parse("div { padding: 5px; padding-left: 40px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 5)
    assert_eq(st.pad_left, 40)
end

#[test]
fn test_margin_shorthand_three_values() is
    let sheet: css::Stylesheet = css::parse("div { margin: 1px 2px 3px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.mar_top, 1)
    assert_eq(st.mar_right, 2)
    assert_eq(st.mar_left, 2)
    assert_eq(st.mar_bottom, 3)
end

;; ---------- style::resolve — rozbudowa: margin: auto ----------

#[test]
fn test_margin_auto_shorthand_both_sides() is
    let sheet: css::Stylesheet = css::parse("div { margin: 0 auto; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    ;; sentinel -1 dopóki layout.h# nie zna avail_w/box_w, żeby rozdzielić przestrzeń
    assert_eq(st.mar_left, -1)
    assert_eq(st.mar_right, -1)
    assert_eq(st.mar_top, 0)
end

#[test]
fn test_margin_auto_left_only() is
    let sheet: css::Stylesheet = css::parse("div { margin-left: auto; margin-right: 10px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.mar_left, -1)
    assert_eq(st.mar_right, 10)
end

;; ---------- style::resolve — rozbudowa: jednostki em/rem ----------

#[test]
fn test_width_rem_multiplies_by_root_font_size() is
    ;; 1rem = 16px zawsze, niezależnie od odziedziczonego font-size
    let sheet: css::Stylesheet = css::parse("div { width: 2rem; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.width, 32)
end

#[test]
fn test_font_size_em_relative_to_inherited() is
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 20
    let sheet: css::Stylesheet = css::parse("span { font-size: 1.5em; }")
    let st: style::ComputedStyle = style::resolve(sheet, "span", "", [], parent)
    assert_eq(st.font_size, 30)
end

#[test]
fn test_padding_em_uses_inherited_font_size() is
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 10
    let sheet: css::Stylesheet = css::parse("div { padding: 1em 2em; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_right, 20)
end

#[test]
fn test_bare_number_without_unit_treated_as_px() is
    ;; leniency: "10" (bez jednostki) parsuje się tak samo jak "10px"
    let sheet: css::Stylesheet = css::parse("div { width: 10; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.width, 10)
end

#[test]
fn test_rem_independent_of_parent_font_size() is
    ;; w odróżnieniu od em, rem NIE zależy od odziedziczonego font-size
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 40
    let sheet: css::Stylesheet = css::parse("div { width: 1rem; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.width, 16)
end

#[test]
fn test_margin_auto_still_works_alongside_em() is
    ;; regresja: sentinel -1 (auto) nie powinien zderzyć się z nową
    ;; obsługą jednostek w tym samym skrócie.
    let sheet: css::Stylesheet = css::parse("div { margin: 1em auto; }")
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 16
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.mar_top, 16)
    assert_eq(st.mar_left, -1)
    assert_eq(st.mar_right, -1)
end

;; ---------- layout::layout — rozbudowa: margin: auto centruje blok ----------

#[test]
fn test_layout_margin_auto_centers_block() is
    ;; viewport 400px, blok o width:100px i margin:0 auto -> powinien
    ;; wylądować w x=150 (400-100=300 nadmiaru, po 150 na bok).
    let dom: dom::Dom = dom::parse("<div class=\"box\"></div>")
    let sheet: css::Stylesheet = css::parse(".box { width: 100px; height: 20px; margin: 0 auto; background: red; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found: layout::LayoutBox = boxes[0]
    let mut ok: bool = false
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].w == 100 && boxes[i].h == 20 is
            found = boxes[i]
            ok = true
        end
        i += 1
    end
    assert_true(ok)
    assert_eq(found.x, 150)
end

#[test]
fn test_layout_margin_auto_no_explicit_width_is_noop() is
    ;; bez jawnej szerokości blok i tak wypełnia całą dostępną
    ;; przestrzeń -> margin:auto nie ma czego rozdzielać (x=0).
    let dom: dom::Dom = dom::parse("<div class=\"box\"></div>")
    let sheet: css::Stylesheet = css::parse(".box { height: 20px; margin: 0 auto; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found: layout::LayoutBox = boxes[0]
    let mut ok: bool = false
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].h == 20 is
            found = boxes[i]
            ok = true
        end
        i += 1
    end
    assert_true(ok)
    assert_eq(found.x, 0)
end

;; ---------- layout::layout_i — rozbudowa: :hover przez pełny pipeline ----------

#[test]
fn test_layout_i_hover_changes_background() is
    let dom: dom::Dom = dom::parse("<div class=\"btn\">x</div>")
    let sheet: css::Stylesheet = css::parse(".btn:hover { background: red; }")
    let btn_id: int = 1  ;; nodes[0]=root, nodes[1]=div.btn

    let no_hover: [layout::LayoutBox] = layout::layout_i(dom, sheet, 400, -1, css::no_interaction())
    let mut bg_no_hover: bool = false
    let mut i: int = 0
    while i < array_len(no_hover) is
        if no_hover[i].node_id == btn_id && no_hover[i].st.has_bg is bg_no_hover = true end
        i += 1
    end
    assert_true(!bg_no_hover)

    let with_hover: [layout::LayoutBox] = layout::layout_i(
        dom, sheet, 400, -1, css::InteractionState { hovered_id: btn_id, focused_id: "", active_id: -1 })
    let mut bg_hover: bool = false
    i = 0
    while i < array_len(with_hover) is
        if with_hover[i].node_id == btn_id && with_hover[i].st.has_bg is bg_hover = true end
        i += 1
    end
    assert_true(bg_hover)
end

;; ---------- style::resolve — rozbudowa: text-align, opacity ----------

#[test]
fn test_text_align_inherits_to_children() is
    let sheet: css::Stylesheet = css::parse("div { text-align: center; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(parent.text_align, "center")
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.text_align, "center")
end

#[test]
fn test_opacity_not_inherited() is
    ;; opacity NIE dziedziczy w CSS (inaczej niż color/text-align) —
    ;; każdy element domyślnie startuje od 100 (w pełni kryjące).
    let sheet: css::Stylesheet = css::parse("div { opacity: 0.5; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(parent.opacity, 50)
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.opacity, 100)
end

#[test]
fn test_opacity_percent_syntax() is
    let sheet: css::Stylesheet = css::parse("div { opacity: 30%; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.opacity, 30)
end

;; ---------- layout::layout — rozbudowa: text-align w praktyce ----------

#[test]
fn test_layout_center_aligns_short_line() is
    ;; viewport szeroki (400px), krótki tekst wyśrodkowany w bloku na
    ;; całą szerokość -> x pudełka tekstu powinien być > 0 (przesunięty
    ;; od lewej krawędzi), nie stać przy inner_x jak przy "left".
    let dom: dom::Dom = dom::parse("<div><p>hi</p></div>")
    let sheet: css::Stylesheet = css::parse("div { width: 400px; } p { text-align: center; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found_x: int = -1
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].text == "hi" is found_x = boxes[i].x end
        i += 1
    end
    assert_true(found_x > 0)
end

;; ---------- css.h# — rozbudowa: selektory potomka/dziecka, grupowanie ----------

#[test]
fn test_css_group_selector_comma() is
    let sheet: css::Stylesheet = css::parse(".a, .b { color: red; }")
    ;; skrót przecinkowy rozwija się do dwóch osobnych reguł
    assert_eq(array_len(sheet.rules), 2)
    assert_eq(sheet.rules[0].selector, ".a")
    assert_eq(sheet.rules[1].selector, ".b")
end

#[test]
fn test_css_tokenize_descendant_selector() is
    let path: css::SelectorPath = css::tokenize_selector(".card p")
    assert_eq(array_len(path.sels), 2)
    assert_eq(path.sels[0], ".card")
    assert_eq(path.sels[1], "p")
    assert_eq(path.combs[1], "desc")
end

#[test]
fn test_css_tokenize_child_selector() is
    let path: css::SelectorPath = css::tokenize_selector(".a > .b")
    assert_eq(array_len(path.sels), 2)
    assert_eq(path.combs[1], "child")
end

#[test]
fn test_css_descendant_selector_matches_nested() is
    ;; <div class="card"><p>x</p></div> — .card p powinno dopasować <p>,
    ;; niezależnie od tego, jak głęboko jest zagnieżdżone.
    let dom: dom::Dom = dom::parse("<div class=\"card\"><p>x</p></div>")
    let sheet: css::Stylesheet = css::parse(".card p { color: red; }")
    ;; węzeł <p> — znajdź go po tagu w drzewie
    let mut p_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].tag == "p" is p_id = i end
        i += 1
    end
    assert_true(p_id >= 0)
    let st: style::ComputedStyle = style::resolve_ctx(sheet, dom, p_id, style::root_style(), css::no_interaction())
    assert_eq(st.color.r, 255)
end

#[test]
fn test_css_child_selector_does_not_match_grandchild() is
    ;; ".a > .b" nie powinno złapać ".b" zagnieżdżonego głębiej niż
    ;; bezpośrednie dziecko ".a".
    let dom: dom::Dom = dom::parse("<div class=\"a\"><div><p class=\"b\">x</p></div></div>")
    let sheet: css::Stylesheet = css::parse(".a > .b { color: red; }")
    let mut p_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].tag == "p" is p_id = i end
        i += 1
    end
    let st: style::ComputedStyle = style::resolve_ctx(sheet, dom, p_id, style::root_style(), css::no_interaction())
    ;; kolor domyślny (dziedziczony/root), nie czerwony — reguła nie trafiła
    assert_true(st.color.r != 255)
end

#[test]
fn test_css_flat_api_ignores_compound_selector() is
    ;; Stare "płaskie" `matching_decls` (bez drzewa) musi bezpiecznie
    ;; NIE dopasować selektora złożonego, zamiast fałszywie trafić.
    let sheet: css::Stylesheet = css::parse(".card p { color: red; }")
    let decls: [css::CssDecl] = css::matching_decls(sheet, "p", "", ["card"])
    assert_eq(array_len(decls), 0)
end

;; ---------- css.h# — rozbudowa: kombinatory rodzeństwa (+/~) ----------

#[test]
fn test_css_tokenize_adjacent_sibling() is
    let path: css::SelectorPath = css::tokenize_selector(".a + .b")
    assert_eq(array_len(path.sels), 2)
    assert_eq(path.combs[1], "adjacent")
end

#[test]
fn test_css_tokenize_general_sibling() is
    let path: css::SelectorPath = css::tokenize_selector(".a ~ .b")
    assert_eq(path.combs[1], "general_sibling")
end

#[test]
fn test_css_adjacent_sibling_matches_immediate_next() is
    ;; <div class="a"></div><p class="b">x</p><p class="c">y</p> —
    ;; ".a + p" powinno złapać TYLKO pierwsze <p> (bezpośrednio po .a).
    let dom: dom::Dom = dom::parse(
        "<div><div class=\"a\"></div><p class=\"b\">x</p><p class=\"c\">y</p></div>")
    let sheet: css::Stylesheet = css::parse(".a + p { color: red; }")
    let mut b_id: int = -1
    let mut c_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "b" is b_id = i end
        if dom.nodes[i].attr_class == "c" is c_id = i end
        i += 1
    end
    let st_b: style::ComputedStyle = style::resolve_ctx(sheet, dom, b_id, style::root_style(), css::no_interaction())
    let st_c: style::ComputedStyle = style::resolve_ctx(sheet, dom, c_id, style::root_style(), css::no_interaction())
    assert_eq(st_b.color.r, 255)
    assert_true(st_c.color.r != 255)
end

#[test]
fn test_css_general_sibling_matches_any_later() is
    ;; ".a ~ p" powinno złapać OBA <p> po .a, nie tylko najbliższe.
    let dom: dom::Dom = dom::parse(
        "<div><div class=\"a\"></div><p class=\"b\">x</p><p class=\"c\">y</p></div>")
    let sheet: css::Stylesheet = css::parse(".a ~ p { color: red; }")
    let mut c_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "c" is c_id = i end
        i += 1
    end
    let st_c: style::ComputedStyle = style::resolve_ctx(sheet, dom, c_id, style::root_style(), css::no_interaction())
    assert_eq(st_c.color.r, 255)
end

;; ---------- css.h# — rozbudowa: pseudoklasy :hover / :focus ----------

#[test]
fn test_css_hover_matches_only_hovered_node() is
    let dom: dom::Dom = dom::parse("<div class=\"btn\">x</div>")
    let sheet: css::Stylesheet = css::parse(".btn:hover { color: red; }")
    let btn_id: int = 1  ;; nodes[0]=root, nodes[1]=div.btn
    let not_hovered: style::ComputedStyle = style::resolve_ctx(
        sheet, dom, btn_id, style::root_style(), css::no_interaction())
    assert_true(not_hovered.color.r != 255)

    let hovered: style::ComputedStyle = style::resolve_ctx(
        sheet, dom, btn_id, style::root_style(),
        css::InteractionState { hovered_id: btn_id, focused_id: "", active_id: -1 })
    assert_eq(hovered.color.r, 255)
end

#[test]
fn test_css_focus_matches_by_attr_id() is
    let dom: dom::Dom = dom::parse("<input id=\"name\" />")
    let sheet: css::Stylesheet = css::parse("#name:focus { border-color: #ff0000; }")
    let input_id: int = 1
    let unfocused: style::ComputedStyle = style::resolve_ctx(
        sheet, dom, input_id, style::root_style(), css::no_interaction())
    assert_true(unfocused.border_color.r != 255)

    let focused: style::ComputedStyle = style::resolve_ctx(
        sheet, dom, input_id, style::root_style(),
