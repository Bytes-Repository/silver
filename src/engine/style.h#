use "silver -> engine -> css" from "css"
use "std -> conv" from "conv"

pub struct Color is
    pub r: int
    pub g: int
    pub b: int
    pub a: int
end

pub struct ComputedStyle is
    pub display:    string   ;; "block" | "inline" | "none" | "flex"
    pub color:      Color
    pub background: Color
    pub has_bg:     bool
    pub width:      int      ;; px, -1 = auto (wypełnij rodzica / dopasuj treść)
    pub height:     int      ;; px, -1 = auto
    pub padding:    int      ;; px, jednolite z każdej strony (v0.1)
    pub margin:     int      ;; px, jednolite z każdej strony (v0.1)
    pub font_size:  int      ;; px
    pub border:     int      ;; px, 0 = brak
    pub border_color: Color
    pub gap:        int      ;; px, odstęp między dziećmi flex (v0.3)
    pub flex_dir:   string    ;; "row" | "column" (tylko gdy display == "flex")
    pub justify:    string     ;; "flex-start" | "center" | "space-between" | "flex-end"
    pub align:      string      ;; "flex-start" | "center" | "flex-end" (cross-axis)
end

;; Styl "korzenia dokumentu" — jedyne miejsce, gdzie kolor/font-size
;; nie pochodzą z dziedziczenia, bo nie ma rodzica. Odpowiednik
;; przeglądarkowego `:root { color: #141414; font-size: 16px }`.
pub fn root_style() -> ComputedStyle is
    return ComputedStyle {
        display: "block",
        color: Color { r: 20, g: 20, b: 20, a: 255 },
        background: Color { r: 0, g: 0, b: 0, a: 0 },
        has_bg: false,
        width: -1, height: -1,
        padding: 0, margin: 0,
        font_size: 16,
        border: 0,
        border_color: Color { r: 0, g: 0, b: 0, a: 255 },
        gap: 0, flex_dir: "row", justify: "flex-start", align: "flex-start"
    }
end

fn default_style_for(tag: string, inherited: ComputedStyle) -> ComputedStyle is
    let mut disp: string = "block"
    if tag == "span" || tag == "a" || tag == "text" is disp = "inline" end

    ;; Nagłówki mają domyślny (przeglądarkowy) rozmiar czcionki, który
    ;; wygrywa z dziedziczeniem — dokładnie jak UA stylesheet w
    ;; prawdziwej przeglądarce — ale jawna reguła CSS `font-size` na
    ;; danym elemencie nadal go nadpisze (patrz koniec `resolve`).
    let mut fsize: int = inherited.font_size
    if tag == "h1" is fsize = 32 end
    if tag == "h2" is fsize = 24 end
    if tag == "h3" is fsize = 20 end

    return ComputedStyle {
        display: disp,
        color: inherited.color,
        background: Color { r: 0, g: 0, b: 0, a: 0 },
        has_bg: false,
        width: -1, height: -1,
        padding: 0, margin: 0,
        font_size: fsize,
        border: 0,
        border_color: Color { r: 0, g: 0, b: 0, a: 255 },
        gap: 0, flex_dir: "row", justify: "flex-start", align: "flex-start"
    }
end

fn parse_px(val: string) -> int is
    if val == "auto" || val == "" is return -1 end
    let stripped: string = string_replace(val, "px", "")
    return str_to_int(string_trim(stripped))
end

;; Rozpoznaje: nazwane kolory podstawowe + #rrggbb.
fn parse_color(val: string) -> Color is
    let v: string = string_trim(val)
    if v == "white"       is return Color { r: 255, g: 255, b: 255, a: 255 } end
    if v == "black"       is return Color { r: 0,   g: 0,   b: 0,   a: 255 } end
    if v == "red"         is return Color { r: 220, g: 40,  b: 40,  a: 255 } end
    if v == "green"       is return Color { r: 40,  g: 170, b: 90,  a: 255 } end
    if v == "blue"        is return Color { r: 40,  g: 90,  b: 220, a: 255 } end
    if v == "gray" || v == "grey" is return Color { r: 130, g: 130, b: 130, a: 255 } end
    if v == "transparent" is return Color { r: 0,   g: 0,   b: 0,   a: 0   } end

    if string_starts_with(v, "#") && string_len(v) >= 7 is
        let r: int = hex_to_int(string_slice(v, 1, 3))
        let g: int = hex_to_int(string_slice(v, 3, 5))
        let b: int = hex_to_int(string_slice(v, 5, 7))
        return Color { r: r, g: g, b: b, a: 255 }
    end
    return Color { r: 0, g: 0, b: 0, a: 255 }
end

fn hex_to_int(h: string) -> int is
    ;; std -> hex / std -> conv wystawiają konwersję hex->int (patrz
    ;; std/hex.h# i std/conv.h#) — tutaj wołamy przez alias `conv`.
    return conv::hex_to_int(h)
end

pub fn resolve(sheet: css::Stylesheet, tag: string, id: string, classes: [string], inherited: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = default_style_for(tag, inherited)
    let decls: [css::CssDecl] = css::matching_decls(sheet, tag, id, classes)
    let count: int = array_len(decls)
    let mut i: int = 0
    while i < count is
        let d: css::CssDecl = decls[i]
        i += 1
        if d.prop == "display" is st.display = string_trim(d.val)
        elsif d.prop == "color" is st.color = parse_color(d.val)
        elsif d.prop == "background" || d.prop == "background-color" is
            st.background = parse_color(d.val)
            st.has_bg = d.val != "transparent"
        elsif d.prop == "width" is st.width = parse_px(d.val)
        elsif d.prop == "height" is st.height = parse_px(d.val)
        elsif d.prop == "padding" is st.padding = parse_px(d.val)
        elsif d.prop == "margin" is st.margin = parse_px(d.val)
        elsif d.prop == "font-size" is st.font_size = parse_px(d.val)
        elsif d.prop == "border" is st.border = parse_px(d.val)
        elsif d.prop == "border-color" is st.border_color = parse_color(d.val)
        elsif d.prop == "gap" is st.gap = parse_px(d.val)
        elsif d.prop == "flex-direction" is st.flex_dir = string_trim(d.val)
        elsif d.prop == "justify-content" is st.justify = string_trim(d.val)
        elsif d.prop == "align-items" is st.align = string_trim(d.val)
        end
    end
    return st
end

;; Rozbija `class="a b c"` na ["a","b","c"].
pub fn split_classes(attr_class: string) -> [string] is
    if string_trim(attr_class) == "" is return [] end
    return string_split(string_trim(attr_class), " ")
end
