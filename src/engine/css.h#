use "silver -> engine -> dom" from "dom"

pub struct CssDecl is
    pub prop: string
    pub val:  string
end

pub struct CssRule is
    pub selector: string     ;; np. ".button", "#title", "p", ".card p",
                              ;; ".a > .b", ".a + .b", ".a ~ .b", ".btn:hover"
    pub decls:    [CssDecl]
end

pub struct Stylesheet is
    pub rules: [CssRule]
end

;; Rozbudowa: rozłożony na proste selektory + kombinatory między nimi
;; złożony selektor (" " = potomek, ">" = bezpośrednie dziecko,
;; "+" = najbliższy poprzedni rodzony, "~" = dowolny poprzedni rodzony).
;; `sels[n-1]` to zawsze selektor węzła docelowego (ten, do którego
;; dopasowujemy regułę); `combs[i]` to kombinator MIĘDZY `sels[i-1]` a
;; `sels[i]` ("none" dla i==0).
pub struct SelectorPath is
    pub sels:  [string]
    pub combs: [string]
end

;; Rozbudowa v0.2: stan interakcji (mysz/focus) do rozwiązywania
;; pseudoklas `:hover`/`:focus`/`:active`. `hovered_id`: id węzła pod
;; kursorem (`-1` = brak/mysz poza treścią). `focused_id`: `attr_id`
;; focusowanego elementu (dziś w praktyce tylko `<input>` — patrz
;; `app.h#`); `""` = nic nie ma focusu. `active_id`: id węzła, na
;; którym trzymany jest wciśnięty przycisk myszy (od `mouse_down` do
;; `mouse_up`, patrz `app::handle_mouse_down`/`handle_mouse_up`);
;; `-1` = nic nie jest wciśnięte. Budowana raz na klatkę w `app.h#` i
;; przekazywana przez `layout::layout_i` do wszystkiego, co rozwiązuje
;; styl. Osobny parametr zamiast pola na `dom::DomNode`, bo `dom::Dom`
;; z `app.h#` jest współdzielony/przechowywany między klatkami (hot
;; reload, `template::apply_state`) — nie chcemy co klatkę mutować
;; węzły tylko po to, żeby zakodować coś, co i tak jest tylko
;; właściwością BIEŻĄCEJ klatki.
pub struct InteractionState is
    pub hovered_id: int
    pub focused_id: string
    pub active_id:  int
end

pub fn no_interaction() -> InteractionState is
    return InteractionState { hovered_id: -1, focused_id: "", active_id: -1 }
end

;; Rozbicie prostego tokenu selektora na część "bazową" (tag/.class/
;; #id) i opcjonalną pseudoklasę po dwukropku, np. ".btn:hover" ->
;; base=".btn", pseudo="hover". Brak dwukropka -> pseudo="".
pub struct TokenParts is
    pub base:   string
    pub pseudo: string
end

fn parse_token_parts(token: string) -> TokenParts is
    let colon: int = string_find(token, ":")
    if colon < 0 is return TokenParts { base: token, pseudo: "" } end
    return TokenParts {
        base: string_slice(token, 0, colon),
        pseudo: string_slice(token, colon + 1, string_len(token))
    }
end

fn parse_decls(block: string) -> [CssDecl] is
    let mut decls: [CssDecl] = []
    let items: [string] = string_split(block, ";")
    let count: int = array_len(items)
    let mut i: int = 0
    while i < count is
        let raw: string = string_trim(items[i])
        i += 1
        if raw == "" is continue end
        let colon: int = string_find(raw, ":")
        if colon < 0 is continue end
        let prop: string = string_trim(string_slice(raw, 0, colon))
        let val:  string = string_trim(string_slice(raw, colon + 1, string_len(raw)))
        if prop != "" is
            decls = array_push(decls, CssDecl { prop: prop, val: val })
        end
    end
    return decls
end

pub fn parse(css: string) -> Stylesheet is
    let stripped: string = strip_comments(css)
    let mut rules: [CssRule] = []
    let n: int = string_len(stripped)
    let mut p: int = 0
    while p < n is
        let open: int = find_char(stripped, "{", p)
        if open < 0 is
            p = n
            continue
        end
        let selector_group: string = string_trim(string_slice(stripped, p, open))
        let close: int = find_char(stripped, "}", open)
        if close < 0 is
            p = n
            continue
        end
        let block: string = string_slice(stripped, open + 1, close)
        let decls: [CssDecl] = parse_decls(block)

        ;; Rozbudowa: grupowanie selektorów przecinkiem, np.
        ;; ".btn, .link { ... }" — dokładnie jak w prawdziwym CSS, to
        ;; skrót na dwie osobne reguły z tymi samymi deklaracjami.
        let group: [string] = string_split(selector_group, ",")
        let gcount: int = array_len(group)
        let mut gi: int = 0
        while gi < gcount is
            let sel: string = string_trim(group[gi])
            gi += 1
            if sel != "" is
                rules = array_push(rules, CssRule { selector: sel, decls: decls })
            end
        end
        p = close + 1
    end
    return Stylesheet { rules: rules }
end

;; Usuwa komentarze `/* ... */` (w tym wieloliniowe) przed parsowaniem —
;; rozbudowa v0.2. Bez tego kroku komentarz umieszczony przed selektorem
;; wciągnąłby się jako część selektora (parser szuka po prostu
;; najbliższego `{`), co po cichu psuje regułę zamiast dać błąd, więc
;; brak wsparcia dla komentarzy był realną pułapką, nie tylko brakiem
;; funkcji. Nie obsługuje `//` (nie jest to poprawny komentarz CSS) ani
;; komentarzy zagnieżdżonych (CSS też ich nie zna).
fn strip_comments(css: string) -> string is
    let mut out: string = ""
    let n: int = string_len(css)
    let mut p: int = 0
    while p < n is
        let start: int = find_char(css, "/*", p)
        if start < 0 is
            out = out + string_slice(css, p, n)
            p = n
            continue
        end
        out = out + string_slice(css, p, start)
        let end_marker: int = find_char(css, "*/", start + 2)
        if end_marker < 0 is
            ;; niedomknięty komentarz do końca pliku — reszta jest ucinana,
            ;; tak jak zrobiłaby to prawdziwa przeglądarka.
            p = n
            continue
        end
        p = end_marker + 2
    end
    return out
end

fn find_char(s: string, ch: string, from: int) -> int is
    if from >= string_len(s) is return -1 end
    let idx: int = string_find(string_slice(s, from, string_len(s)), ch)
    if idx < 0 is return -1 end
    return idx + from
end

;; Rozbicie POJEDYNCZEGO tokenu selektora (bez pseudoklasy — tę zdejmuje
;; wcześniej `parse_token_parts`) na tag/klasy/id, np. "div.btn.primary"
;; -> tag="div", classes=["btn","primary"], id="". CSS pozwala łączyć
;; tag + dowolną liczbę klas + id BEZ kombinatora, żeby wymagać ich
;; wszystkich naraz na JEDNYM elemencie (w przeciwieństwie do np.
;; ".a .b", gdzie spacja oznacza "gdziekolwiek w przodkach").
pub struct CompoundSimple is
    pub tag:     string    ;; "" = dowolny tag
    pub classes: [string]
    pub id:      string    ;; "" = bez wymogu id
end

fn parse_compound_simple(token: string) -> CompoundSimple is
    let mut tag: string = ""
    let mut classes: [string] = []
    let mut id: string = ""
    let n: int = string_len(token)
    let mut seg_start: int = 0
    let mut seg_kind: string = "tag"
    let mut i: int = 0
    while i < n is
        let c: string = string_slice(token, i, i + 1)
        if c == "." || c == "#" is
            let seg: string = string_slice(token, seg_start, i)
            if seg != "" is
                if seg_kind == "tag" is tag = seg
                elsif seg_kind == "class" is classes = array_push(classes, seg)
                else is id = seg end
            end
            seg_kind = if c == "." then "class" else "id"
            seg_start = i + 1
        end
        i += 1
    end
    let last: string = string_slice(token, seg_start, n)
    if last != "" is
        if seg_kind == "tag" is tag = last
        elsif seg_kind == "class" is classes = array_push(classes, last)
        else is id = last end
    end
    return CompoundSimple { tag: tag, classes: classes, id: id }
end

fn compound_simple_matches(cs: CompoundSimple, tag: string, id: string, node_classes: [string]) -> bool is
    if cs.tag != "" && cs.tag != tag is return false end
    if cs.id != "" && cs.id != id is return false end
    let need: int = array_len(cs.classes)
    let mut i: int = 0
    while i < need is
        let want: string = cs.classes[i]
        let mut found: bool = false
        let mut j: int = 0
        while j < array_len(node_classes) is
            if node_classes[j] == want is found = true end
            j += 1
        end
        if !found is return false end
        i += 1
    end
    return true
end

;; Czy PROSTY (bez kombinatorów) selektor pasuje do węzła o danym
;; tagu/id/klasach — obsługuje pojedyncze tag/`.class`/`#id`, a od tej
;; rozbudowy też DOWOLNĄ ich kombinację bez kombinatora, np.
;; "div.btn.primary" albo "#card.active" (patrz `parse_compound_simple`
;; wyżej — poprzednia wersja tej funkcji sprawdzała tylko PIERWSZY
;; token po kropce, więc ".btn.primary" po cichu nigdy nie dopasowywało
;; niczego — realny błąd, nie tylko brak funkcji, złapany przy pisaniu
;; demo w szablonie `kitchen_sink`, które od początku miało dokładnie
;; taki selektor). Dla selektora złożonego kombinatorem (" "/">"/"+"/"~"
;; w środku) to wciąż "działa" bez crasha, ale najpewniej nie znajdzie
;; dopasowania — np. ".card p" zaczyna się od "." więc trafia w gałąź
;; klasy i szuka klasy dosłownie nazwanej "card p", której żaden
;; element nie ma. To zamierzone bezpieczne zachowanie starego,
;; "płaskiego" API (`matching_decls`/`resolve` bez kontekstu drzewa) —
;; pełne wsparcie kombinatorów i pseudoklas jest w
;; `matching_decls_ctx`/`style::resolve_ctx`, których używa silnik
;; layoutu (ma dostęp do `dom::Dom` i `InteractionState`). Nie obsługuje
;; pseudoklas — wołający powinien podać samą część bazową (patrz
;; `node_matches_simple` niżej, które robi to rozbicie przed
;; wywołaniem tej funkcji).
pub fn selector_matches(selector: string, tag: string, id: string, classes: [string]) -> bool is
    let cs: CompoundSimple = parse_compound_simple(selector)
    return compound_simple_matches(cs, tag, id, classes)
end

;; Specyficzność prostego selektora (jednego tokenu, może mieć
;; pseudoklasę i/lub kilka klas naraz, np. ".btn.primary:hover"):
;; id=3 (jeśli jest `#id`), inaczej class-poziom=2 jeśli jest
;; przynajmniej jedna `.class` ALBO pseudoklasa, inaczej sam tag=1.
;; UPROSZCZENIE: to wciąż jeden "poziom" na token, nie suma — dwie
;; klasy na tym samym tokenie (`.btn.primary`) liczą się tyle samo co
;; jedna (obie=2), mimo że w prawdziwym CSS `.btn.primary` (2×10) bije
;; samo `.btn` (1×10). Patrz też komentarz przy `specificity` niżej.
fn specificity_simple(token: string) -> int is
    let parts: TokenParts = parse_token_parts(token)
    let cs: CompoundSimple = parse_compound_simple(parts.base)
    if cs.id != "" is return 3 end
    if array_len(cs.classes) > 0 || parts.pseudo != "" is return 2 end
    return 1
end

;; Specyficzność selektora złożonego — UPROSZCZENIE: liczymy tylko
;; specyficzność ostatniego (docelowego) prostego selektora, nie sumę
;; wszystkich jak w prawdziwym CSS (`#a .b` naprawdę miałoby 3+2=5, tu
;; ma 2, bo ostatni token to `.b`). W praktyce dla typowych reguł
;; (".card p", ".a > .b", ".btn:hover", ".btn.primary") daje sensowną,
;; przewidywalną kolejność w prostej 3-koszykowej kaskadzie poniżej —
;; patrz ROADMAP.md, jeśli kiedyś zajdzie potrzeba pełnego sumowania.
pub fn specificity(selector: string) -> int is
    let path: SelectorPath = tokenize_selector(selector)
    let n: int = array_len(path.sels)
    if n == 0 is return 1 end
    return specificity_simple(path.sels[n - 1])
end

;; Otacza kombinatory (">", "+", "~") spacjami, żeby dalszy
;; split-po-spacji zawsze wydzielił je jako osobne tokeny niezależnie
;; od tego, czy autor CSS napisał "a>b", "a > b" czy "a >b" (i tak
;; samo dla "+"/"~"). Rozbudowa (`:nth-child`): pomija znaki wewnątrz
;; nawiasów — argument pseudoklasy jak `nth-child(2n+1)` zawiera
;; dosłowny znak "+", który NIE jest kombinatorem rodzeństwa. Naiwny
;; `string_replace` na całym selektorze rozbiłby taki argument w pół
;; (`nth-child(2n` + kombinator + `1)`) — złapane właśnie przy pisaniu
;; tej rozbudowy, zanim trafiło do jakiegokolwiek szablonu.
fn normalize_combinators(selector: string) -> string is
    let mut out: string = ""
    let n: int = string_len(selector)
    let mut depth: int = 0
    let mut i: int = 0
    while i < n is
        let c: string = string_slice(selector, i, i + 1)
        if c == "(" is depth += 1
        elsif c == ")" is depth -= 1
        end
        if depth == 0 && (c == ">" || c == "+" || c == "~") is
            out = out + " " + c + " "
        else is
            out = out + c
        end
        i += 1
    end
    return out
end

;; Rozbija selektor złożony na proste selektory + kombinatory między
;; nimi. Selektor prosty (bez spacji/kombinatorów) zwraca ścieżkę
;; jednoelementową — więc ta funkcja jest bezpieczna do wołania zawsze,
;; nie tylko dla faktycznie złożonych selektorów.
pub fn tokenize_selector(selector: string) -> SelectorPath is
    let norm: string = normalize_combinators(selector)
    let raw: [string] = string_split(string_trim(norm), " ")
    let mut sels:  [string] = []
    let mut combs: [string] = []
    let mut pending_comb: string = ""
    let count: int = array_len(raw)
    let mut i: int = 0
    while i < count is
        let t: string = string_trim(raw[i])
        i += 1
        if t == "" is continue end
        if t == ">" is
            pending_comb = "child"
            continue
        end
        if t == "+" is
            pending_comb = "adjacent"
            continue
        end
        if t == "~" is
            pending_comb = "general_sibling"
            continue
        end
        sels = array_push(sels, t)
        if array_len(sels) == 1 is
            combs = array_push(combs, "none")
        elsif pending_comb != "" is
            combs = array_push(combs, pending_comb)
        else is
            combs = array_push(combs, "desc")
        end
        pending_comb = ""
    end
    return SelectorPath { sels: sels, combs: combs }
end

;; Rozbicie argumentu formuły `:nth-child(...)` na współczynniki
;; `a`/`b` postaci `an+b`, dokładnie jak w prawdziwym CSS. `odd` to
;; skrót na `2n+1`, `even` na `2n`. Sama liczba (np. `3`) to `a=0,b=3`
;; (dopasowuje TYLKO pozycję 3, nie ciąg arytmetyczny).
pub struct NthExpr is
    pub a: int
    pub b: int
end

;; Usuwa spacje i wiodący "+" (str_to_int nie zawsze go akceptuje),
;; żeby "+1", " 1", "1" parsowały się tak samo.
fn clean_int_part(s: string) -> string is
    let t: string = string_trim(s)
    if string_starts_with(t, "+") is return string_slice(t, 1, string_len(t)) end
    return t
end

pub fn parse_nth_expr(raw: string) -> NthExpr is
    let arg: string = string_trim(raw)
    if arg == "odd" is return NthExpr { a: 2, b: 1 } end
    if arg == "even" is return NthExpr { a: 2, b: 0 } end
    let n_pos: int = string_find(arg, "n")
    if n_pos < 0 is
        ;; sama liczba, bez "n" -> dopasowuje dokładnie jedną pozycję
        return NthExpr { a: 0, b: str_to_int(clean_int_part(arg)) }
    end
    let a_part: string = string_trim(string_slice(arg, 0, n_pos))
    let mut a: int = 1
    if a_part == "-" is a = -1
    elsif a_part == "" is a = 1
    else is a = str_to_int(clean_int_part(a_part)) end
    let b_part: string = string_trim(string_slice(arg, n_pos + 1, string_len(arg)))
    let mut b: int = 0
    if b_part != "" is b = str_to_int(clean_int_part(b_part)) end
    return NthExpr { a: a, b: b }
end

;; Czy 1-indeksowana pozycja `index` pasuje do formuły `an+b`, czyli
;; czy istnieje CAŁKOWITE n >= 0 takie, że a*n+b == index. Dla `a==0`
;; (sama liczba, np. `:nth-child(3)`) to zwykłe porównanie.
pub fn nth_matches(expr: NthExpr, index: int) -> bool is
    if expr.a == 0 is return index == expr.b end
    let diff: int = index - expr.b
    if diff % expr.a != 0 is return false end
    return diff / expr.a >= 0
end

;; 1-indeksowana pozycja węzła wśród RODZEŃSTWA BĘDĄCEGO ELEMENTAMI
;; (węzły tekstowe pomijane — dokładnie jak w prawdziwym CSS, gdzie
;; `:nth-child` liczy tylko elementy, nie tekst między nimi). `-1`,
;; jeśli węzeł jakimś cudem nie jest wśród dzieci swojego rodzica
;; (nie powinno się zdarzyć przy poprawnym `dom::Dom`).
fn nth_child_index(dom: dom::Dom, node_id: int) -> int is
    let parent: int = dom.nodes[node_id].parent
    if parent < 0 is return 1 end   ;; root nie ma rodzeństwa -> jedyne dziecko
    let kids: [int] = dom.nodes[parent].children
    let kc: int = array_len(kids)
    let mut idx: int = 0
    let mut i: int = 0
    while i < kc is
        if dom.nodes[kids[i]].tag != "text" is
            idx += 1
            if kids[i] == node_id is return idx end
        end
        i += 1
    end
    return -1
end

;; Całkowita liczba rodzeństwa BĘDĄCEGO ELEMENTAMI (włącznie z samym
;; `node_id`), czyli mianownik potrzebny dla `:last-child`,
;; `:nth-last-child(...)` i `:only-child`. Root (bez rodzica) liczy się
;; jako jedyne "dziecko" samego siebie — spójnie z `nth_child_index`.
fn sibling_element_count(dom: dom::Dom, node_id: int) -> int is
    let parent: int = dom.nodes[node_id].parent
    if parent < 0 is return 1 end
    let kids: [int] = dom.nodes[parent].children
    let kc: int = array_len(kids)
    let mut count: int = 0
    let mut i: int = 0
    while i < kc is
        if dom.nodes[kids[i]].tag != "text" is count += 1 end
        i += 1
    end
    return count
end

;; Czy `node_id` jest tym samym węzłem co `target`, ALBO jego
;; przodkiem. Używane, żeby `:hover`/`:active` propagowały się w górę
;; drzewa dokładnie tak, jak w prawdziwej przeglądarce: najechanie na
;; tekst wewnątrz `<button><span>Click</span></button>` sprawia, że
;; `:hover` dopasowuje TAKŻE `<button>` (i wszystkich przodków), nie
;; tylko dosłownie trafiony liść. Bez tego `App.hovered_node`/
;; `active_node` (node_id najgłębszego trafienia, patrz
;; `paint::hit_test_any`) nigdy by nie zrównał się z id kontenera,
;; który faktycznie ma regułę `:hover` w CSS.
fn is_self_or_ancestor(dom: dom::Dom, target: int, node_id: int) -> bool is
    let mut cur: int = node_id
    while cur >= 0 is
        if cur == target is return true end
        cur = dom.nodes[cur].parent
    end
    return false
end

;; Szuka węzła o dokładnie takim `attr_id` (pierwsze trafienie, w
;; kolejności `dom.nodes`) — pomocnicze dla `:focus-within`, które w
;; przeciwieństwie do `:focus` nie porównuje `attr_id` bezpośrednio,
;; tylko musi najpierw ustalić, KTÓRY węzeł jest tym focusowanym, żeby
;; potem sprawdzić czy `node_id` jest jego przodkiem. `""` (brak
;; focusu) zawsze zwraca -1, żeby dwa elementy bez id nie "dzieliły"
;; focusu (spójnie z `:focus`). O(liczba węzłów) na wywołanie — bez
;; cache'owania, bo Silver i tak przelicza cały layout co klatkę.
fn find_node_by_attr_id(dom: dom::Dom, attr_id: string) -> int is
    if attr_id == "" is return -1 end
    let n: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < n is
        if dom.nodes[i].attr_id == attr_id is return i end
        i += 1
    end
    return -1
end

;; Czy węzeł `node_id` w `dom` pasuje do JEDNEGO prostego tokenu
;; selektora, łącznie z ewentualną pseudoklasą (np. ".card",
;; "#title", "p", ".btn:hover") — pomocnicze dla `compound_matches`,
;; żeby nie duplikować logiki `selector_matches`.
;;
;; Wspierane pseudoklasy: `:hover`/`:active` (patrz
;; `InteractionState.hovered_id`/`active_id` — dopasowują węzeł LUB
;; dowolnego jego POTOMKA pod kursorem/wciśnięciem, patrz
;; `is_self_or_ancestor` wyżej — to zgodne z prawdziwym CSS), `:focus`
;; (patrz `InteractionState.focused_id`, dopasowywane po `attr_id`
;; węzła — pusty `attr_id` nigdy nie dopasowuje `:focus`, żeby dwa
;; elementy bez id nie "dzieliły" focusu; `:focus` NIE propaguje się
;; do przodków — dokładnie jak w prawdziwym CSS, w odróżnieniu od
;; `:hover`/`:active`), `:focus-within` (jak `:focus`, ale DOPASOWUJE
;; też przodków focusowanego elementu — patrz `find_node_by_attr_id` +
;; `is_self_or_ancestor`), `:nth-child(...)`/`:nth-last-child(...)`
;; (formuła `an+b`/`odd`/`even`/liczba — patrz `parse_nth_expr`/
;; `nth_matches`/`nth_child_index`/`sibling_element_count`),
;; `:first-child`/`:last-child`/`:only-child`. Wszystkie pseudoklasy
;; pozycyjne NIE zależą od `interaction`, więc dopasowują identycznie
;; na każdej klatce. Nieznana pseudoklasa (np. `:visited` —
;; nieobsługiwana) bezpiecznie NIGDY nie dopasowuje, zamiast zgadywać.
fn node_matches_simple(dom: dom::Dom, node_id: int, token: string, interaction: InteractionState) -> bool is
    let n: dom::DomNode = dom.nodes[node_id]
    let parts: TokenParts = parse_token_parts(token)
    let classes: [string] = split_classes_local(n.attr_class)
    if !selector_matches(parts.base, n.tag, n.attr_id, classes) is return false end
    if parts.pseudo == "" is return true end
    if parts.pseudo == "hover" is
        return interaction.hovered_id >= 0 && is_self_or_ancestor(dom, node_id, interaction.hovered_id)
    end
    if parts.pseudo == "active" is
        return interaction.active_id >= 0 && is_self_or_ancestor(dom, node_id, interaction.active_id)
    end
    if parts.pseudo == "focus" is
        return n.attr_id != "" && n.attr_id == interaction.focused_id
    end
    if parts.pseudo == "focus-within" is
        let focused_node: int = find_node_by_attr_id(dom, interaction.focused_id)
        return focused_node >= 0 && is_self_or_ancestor(dom, node_id, focused_node)
    end
    if parts.pseudo == "first-child" is return nth_child_index(dom, node_id) == 1 end
    if parts.pseudo == "last-child" is
        return nth_child_index(dom, node_id) == sibling_element_count(dom, node_id)
    end
    if parts.pseudo == "only-child" is return sibling_element_count(dom, node_id) == 1 end
    if string_starts_with(parts.pseudo, "nth-child(") && string_ends_with(parts.pseudo, ")") is
        let arg: string = string_slice(parts.pseudo, 10, string_len(parts.pseudo) - 1)
        let expr: NthExpr = parse_nth_expr(arg)
        let idx: int = nth_child_index(dom, node_id)
        if idx < 0 is return false end
        return nth_matches(expr, idx)
    end
    if string_starts_with(parts.pseudo, "nth-last-child(") && string_ends_with(parts.pseudo, ")") is
        let arg: string = string_slice(parts.pseudo, 15, string_len(parts.pseudo) - 1)
        let expr: NthExpr = parse_nth_expr(arg)
        let idx: int = nth_child_index(dom, node_id)
        if idx < 0 is return false end
        let idx_from_end: int = sibling_element_count(dom, node_id) - idx + 1
        return nth_matches(expr, idx_from_end)
    end
    return false
end

;; Duplikat `style::split_classes` — nie importujemy `style.h#` tutaj,
;; żeby uniknąć cyklu (style.h# już importuje css.h#).
fn split_classes_local(attr_class: string) -> [string] is
    if string_trim(attr_class) == "" is return [] end
    return string_split(string_trim(attr_class), " ")
end

;; Poprzedni rodzeni węzła `node_id` (ten sam rodzic), w kolejności od
;; NAJBLIŻSZEGO do najdalszego — pomocnicze dla kombinatorów "+"/"~".
;; Pusta lista, jeśli węzeł jest pierwszym dzieckiem albo jest rootem
;; (`parent < 0`).
fn prev_siblings(dom: dom::Dom, node_id: int) -> [int] is
    let self_parent: int = dom.nodes[node_id].parent
    if self_parent < 0 is return [] end
    let kids: [int] = dom.nodes[self_parent].children
    let kc: int = array_len(kids)
    let mut idx: int = -1
    let mut i: int = 0
    while i < kc is
        if kids[i] == node_id is idx = i end
        i += 1
    end
    if idx <= 0 is return [] end
    let mut out: [int] = []
    let mut j: int = idx - 1
    while j >= 0 is
        out = array_push(out, kids[j])
        j -= 1
    end
    return out
end

;; Dopasowuje selektor złożony do węzła, chodząc po przodkach/
;; rodzeństwie w `dom` (`DomNode.parent`/`.children`). Selektor
;; jednoelementowy sprawdza tylko sam węzeł. Drzewo-świadome wsparcie
;; dla " " (dowolny przodek), ">" (bezpośredni rodzic), "+" (najbliższy
;; poprzedni rodzony) i "~" (dowolny poprzedni rodzony), plus
;; pseudoklasy `:hover`/`:focus`/`:active`/`:nth-child` (patrz
;; `node_matches_simple`).
pub fn compound_matches(dom: dom::Dom, node_id: int, path: SelectorPath, interaction: InteractionState) -> bool is
    let n: int = array_len(path.sels)
    if n == 0 is return true end
    if !node_matches_simple(dom, node_id, path.sels[n - 1], interaction) is return false end

    let mut cur: int = node_id
    let mut i: int = n - 2
    while i >= 0 is
        let comb: string = path.combs[i + 1]
        if comb == "child" is
            cur = dom.nodes[cur].parent
            if cur < 0 is return false end
            if !node_matches_simple(dom, cur, path.sels[i], interaction) is return false end
        elsif comb == "adjacent" is
            let sibs: [int] = prev_siblings(dom, cur)
            if array_len(sibs) == 0 is return false end
            let prev: int = sibs[0]
            if !node_matches_simple(dom, prev, path.sels[i], interaction) is return false end
            cur = prev
        elsif comb == "general_sibling" is
            let sibs: [int] = prev_siblings(dom, cur)
            let mut found_s: bool = false
            let mut si: int = 0
            while si < array_len(sibs) is
                if node_matches_simple(dom, sibs[si], path.sels[i], interaction) is
                    found_s = true
                    cur = sibs[si]
                    break
                end
                si += 1
            end
            if !found_s is return false end
        else is
            let mut p: int = dom.nodes[cur].parent
            let mut found: bool = false
            while p >= 0 is
                if node_matches_simple(dom, p, path.sels[i], interaction) is
                    found = true
                    cur = p
                    break
                end
                p = dom.nodes[p].parent
            end
            if !found is return false end
        end
        i -= 1
    end
    return true
end

;; Wspólne bucketowanie po specyficzności (3 koszyki: 1/2/reszta),
;; dzielone przez `matching_decls` i `matching_decls_ctx`, żeby nie
;; duplikować konkatenacji low/mid/high w dwóch miejscach.
fn concat_buckets(low: [CssDecl], mid: [CssDecl], high: [CssDecl]) -> [CssDecl] is
    let mut result: [CssDecl] = []
    let mut k: int = 0
    while k < array_len(low) is
        result = array_push(result, low[k])
        k += 1
    end
    k = 0
    while k < array_len(mid) is
        result = array_push(result, mid[k])
        k += 1
    end
    k = 0
    while k < array_len(high) is
        result = array_push(result, high[k])
        k += 1
    end
    return result
end

;; Zwraca deklaracje pasujące do węzła, posortowane od najmniej do
;; najbardziej specyficznych (żeby ostatnia wygrywała przy nadpisywaniu
;; w style::resolve — prosta kaskada bez !important).
;;
;; UWAGA: to jest "płaskie" API bez dostępu do drzewa DOM — selektory
;; złożone (potomek/dziecko/rodzeństwo) i pseudoklasy nigdy tu nie
;; trafią (patrz komentarz przy `selector_matches`). Używane
;; bezpośrednio (np. w testach) oraz przez `style::resolve`. Silnik
;; layoutu używa `matching_decls_ctx` niżej, który ma pełne wsparcie.
pub fn matching_decls(sheet: Stylesheet, tag: string, id: string, classes: [string]) -> [CssDecl] is
    let mut low:  [CssDecl] = []
    let mut mid:  [CssDecl] = []
    let mut high: [CssDecl] = []
    let count: int = array_len(sheet.rules)
    let mut i: int = 0
    while i < count is
        let rule: CssRule = sheet.rules[i]
        i += 1
        if !selector_matches(rule.selector, tag, id, classes) is continue end
        let spec: int = specificity(rule.selector)
        let mut j: int = 0
        let dc: int = array_len(rule.decls)
        while j < dc is
            if spec == 1 is low  = array_push(low,  rule.decls[j])
            elsif spec == 2 is mid  = array_push(mid,  rule.decls[j])
            else is high = array_push(high, rule.decls[j]) end
            j += 1
        end
    end
    return concat_buckets(low, mid, high)
end

;; Jak `matching_decls`, ale drzewo-świadome: rozwiązuje selektory
;; złożone (" " = dowolny przodek, ">" = bezpośredni rodzic, "+"/"~" =
;; rodzeństwo) i pseudoklasy `:hover`/`:focus`/`:active`/`:nth-child`
;; chodząc po `dom::Dom` i sprawdzając `interaction`. Rozbudowa v0.2 —
;; używana przez `style::resolve_ctx`, którego z kolei używa
;; `engine/layout.h#`.
pub fn matching_decls_ctx(sheet: Stylesheet, dom: dom::Dom, node_id: int, interaction: InteractionState) -> [CssDecl] is
    let mut low:  [CssDecl] = []
    let mut mid:  [CssDecl] = []
    let mut high: [CssDecl] = []
    let count: int = array_len(sheet.rules)
    let mut i: int = 0
    while i < count is
        let rule: CssRule = sheet.rules[i]
        i += 1
        let path: SelectorPath = tokenize_selector(rule.selector)
        if !compound_matches(dom, node_id, path, interaction) is continue end
        let spec: int = specificity(rule.selector)
        let mut j: int = 0
        let dc: int = array_len(rule.decls)
        while j < dc is
            if spec == 1 is low  = array_push(low,  rule.decls[j])
            elsif spec == 2 is mid  = array_push(mid,  rule.decls[j])
            else is high = array_push(high, rule.decls[j]) end
            j += 1
        end
    end
    return concat_buckets(low, mid, high)
end
