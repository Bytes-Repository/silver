use "silver -> ffi_shim" from "ffi"

pub struct Window is
    pub handle: int
    pub title:  string
    pub width:  int
    pub height: int
    pub open:   bool
end

pub struct InputEvent is
    pub kind: string   ;; "quit" | "mouse_down" | "mouse_up" | "mouse_move"
                        ;; | "key_down" | "key_up" | "resize" | "text"
                        ;; | "scroll" | "focus_gained" | "focus_lost" | "none"
    pub x:    int
    pub y:    int
    pub code: int       ;; keycode dla key_down/key_up, przycisk myszy dla mouse_*,
                         ;; delta (px) dla scroll (w polu y)
    pub text: string     ;; wpisany tekst dla "text"
end

pub fn create(title: string, width: int, height: int) -> Window is
    let h: int = ffi::silver_window_create(title, width, height)
    return Window { handle: h, title: title, width: width, height: height, open: h >= 0 }
end

;; Ładuje font użyty przez engine::paint do rysowania tekstu.
;; Domyślnie warto wskazać jakiś font systemowy, np.
;; "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
pub fn load_font(win: Window, path: string, size: int) -> bool is
    return ffi::silver_load_font(win.handle, path, size)
end

pub fn is_open(win: Window) -> bool is
    return win.open && ffi::silver_is_open(win.handle)
end

;; Zwraca kolejne zdarzenie wejścia z kolejki SDL. Wołaj w pętli
;; (`while true` z `poll` zwracającym "none" gdy kolejka pusta) raz na
;; klatkę, zanim wykonasz layout/paint.
pub fn poll(win: Window) -> InputEvent is
    let code: int = ffi::silver_poll_event(win.handle)
    if code == 0 is
        return InputEvent { kind: "none", x: 0, y: 0, code: 0, text: "" }
    end

    let payload: string = ffi::silver_event_payload(win.handle)
    let parts: [string] = payload.split("|")
    let px: int = if parts.len() > 0 then str_to_int(parts[0]) else 0
    let py: int = if parts.len() > 1 then str_to_int(parts[1]) else 0
    let extra: string = if parts.len() > 2 then parts[2] else ""

    match code is
        1 => return InputEvent { kind: "quit",       x: 0,  y: 0,  code: 0, text: "" }
        2 => return InputEvent { kind: "mouse_down",  x: px, y: py, code: str_to_int(extra), text: "" }
        3 => return InputEvent { kind: "mouse_up",    x: px, y: py, code: str_to_int(extra), text: "" }
        4 => return InputEvent { kind: "mouse_move",  x: px, y: py, code: 0, text: "" }
        5 => return InputEvent { kind: "key_down",    x: 0,  y: 0,  code: str_to_int(extra), text: "" }
        6 => return InputEvent { kind: "resize",      x: px, y: py, code: 0, text: "" }
        7 => return InputEvent { kind: "text",        x: 0,  y: 0,  code: 0, text: extra }
        8 => return InputEvent { kind: "scroll",      x: 0,  y: py, code: 0, text: "" }
        9 => return InputEvent { kind: "focus_gained", x: 0, y: 0,  code: 0, text: "" }
        10 => return InputEvent { kind: "focus_lost",  x: 0, y: 0,  code: 0, text: "" }
        11 => return InputEvent { kind: "key_up",      x: 0, y: 0,  code: str_to_int(extra), text: "" }
    end
    return InputEvent { kind: "none", x: 0, y: 0, code: 0, text: "" }
end

;; Aktualna szerokość okna wg SDL (może się różnić od win.width po
;; resize — window::poll aktualizuje win.width/height dopiero gdy
;; dostaniesz event "resize"; to jest zawsze świeże).
pub fn ffi_width(win: Window) -> int is
    return ffi::silver_get_width(win.handle)
end

pub fn ffi_height(win: Window) -> int is
    return ffi::silver_get_height(win.handle)
end

pub fn set_title(win: Window, title: string) -> bool is
    return ffi::silver_set_title(win.handle, title)
end

pub fn present(win: Window) -> bool is
    return ffi::silver_present(win.handle)
end

pub fn close(win: Window) -> bool is
    return ffi::silver_window_close(win.handle)
end

;; Włącza/wyłącza przechwytywanie tekstu (SDL_StartTextInput) — wołaj
;; przy focusowaniu/blurowaniu edytowalnego <input>, patrz app.h#.
pub fn start_text_input(win: Window) -> bool is
    return ffi::silver_start_text_input(win.handle)
end

pub fn stop_text_input(win: Window) -> bool is
    return ffi::silver_stop_text_input(win.handle)
end

;; "dark" | "light" — best-effort, patrz native/silver_shim.c (na dziś
;; tylko Linux/GNOME; inne platformy zawsze "light").
pub fn system_theme() -> string is
    return ffi::silver_system_theme()
end
